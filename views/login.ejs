<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guess the Score - Login</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="auth-container">
    <div class="auth-card">
      <h1>Guess the Score</h1>
      <p class="subtitle">Predict match results & compete with friends</p>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="POST" action="/login">
        <input type="text" name="username" placeholder="Username" required autocomplete="username">
        <input type="password" name="password" placeholder="Password" required autocomplete="current-password">
        <button type="submit">Sign In</button>
      </form>
      <p class="auth-link">Don't have an account? <a href="/register">Register</a></p>
      <p class="auth-link" style="margin-top:0.5rem;font-size:0.8rem;">Default admin: <strong>admin</strong> / <strong>admin123</strong></p>
    </div>
  </div>
</body>
</html>
