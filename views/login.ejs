<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guess the Score - Login</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <% if (adsense) { %><meta name="google-adsense-account" content="<%= adsense.client %>"><% } %>
</head>
<body>
  <div class="auth-container">
    <div class="auth-card">
      <h1>Guess the Score</h1>
      <p class="subtitle">Predict match results & compete with friends</p>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="username" placeholder="Username" required autocomplete="username" maxlength="30">
        <input type="password" name="password" placeholder="Password" required autocomplete="current-password">
        <button type="submit">Sign In</button>
      </form>
      <p class="auth-link">Don't have an account? <a href="/register">Register</a></p>
    </div>
  </div>
  <%- include('partials/footer') %>
  <%- include('partials/consent-banner') %>
</body>
</html>
