<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guess the Score - Admin</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <% if (adsense) { %><meta name="google-adsense-account" content="<%= adsense.client %>"><% } %>
</head>
<body>
  <nav class="navbar">
    <div class="nav-inner">
      <a href="/leagues" class="nav-brand">Guess the Score</a>
      <div class="nav-links">
        <a href="/leagues">My Leagues</a>
        <a href="/leagues/<%= league.id %>/games">Games</a>
        <a href="/leagues/<%= league.id %>/rankings">Rankings</a>
        <a href="/leagues/<%= league.id %>/admin" class="active">Manage</a>
        <span class="username"><%= user.username %></span>
        <form method="POST" action="/logout" class="logout-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit">Logout</button>
        </form>
      </div>
    </div>
  </nav>

  <div class="container">
    <h2>Add New Game - <%= league.name %></h2>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form class="admin-form" method="POST" action="/leagues/<%= league.id %>/games">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label style="display:block;font-size:0.85rem;color:var(--text-muted);margin-bottom:0.3rem;">Phase</label>
        <select name="phase" required>
          <option value="group">Group Stage (<%= phasePoints.group %> pts)</option>
          <option value="round_of_16">Round of 16 (<%= phasePoints.round_of_16 %> pts)</option>
          <option value="quarter">Quarter-finals (<%= phasePoints.quarter %> pts)</option>
          <option value="semi">Semi-finals (<%= phasePoints.semi %> pts)</option>
          <option value="third_place">Third Place (<%= phasePoints.third_place %> pts)</option>
          <option value="final">Final (<%= phasePoints.final %> pts)</option>
        </select>
      </div>
      <div>
        <label style="display:block;font-size:0.85rem;color:var(--text-muted);margin-bottom:0.3rem;">Home Team</label>
        <input type="text" name="home_team" placeholder="e.g. Brazil" required maxlength="40">
      </div>
      <div>
        <label style="display:block;font-size:0.85rem;color:var(--text-muted);margin-bottom:0.3rem;">Away Team</label>
        <input type="text" name="away_team" placeholder="e.g. Argentina" required maxlength="40">
      </div>
      <div>
        <label style="display:block;font-size:0.85rem;color:var(--text-muted);margin-bottom:0.3rem;">Start Time</label>
        <input type="datetime-local" name="start_time" required>
      </div>
      <button type="submit">Add Game</button>
    </form>

    <h2>All Games</h2>
    <% if (games.length === 0) { %>
      <div class="empty">No games added yet.</div>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Phase</th>
            <th>Home Team</th>
            <th>Away Team</th>
            <th>Start Time</th>
            <th>Status</th>
            <th>Correct Result</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% games.forEach(game => { %>
            <tr>
              <td><span class="phase-badge phase-<%= game.phase %>"><%= game.phase.replace(/_/g, ' ') %></span></td>
              <td><%= game.home_team %></td>
              <td><%= game.away_team %></td>
              <td><%= new Date(game.start_time).toLocaleString() %></td>
              <td><%= game.status === 'finished' ? 'Finished' : new Date(game.start_time) <= new Date() ? 'Started' : 'Scheduled' %></td>
              <td>
                <form method="POST" action="/leagues/<%= league.id %>/games/<%= game.id %>/result" class="result-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="text" name="home_score" inputmode="numeric" pattern="[0-9]{1,5}" maxlength="5" data-digits data-maxlen="5" placeholder="H" value="<%= game.home_score !== null ? game.home_score : '' %>" required>
                  <span style="color:var(--text-muted);">-</span>
                  <input type="text" name="away_score" inputmode="numeric" pattern="[0-9]{1,5}" maxlength="5" data-digits data-maxlen="5" placeholder="A" value="<%= game.away_score !== null ? game.away_score : '' %>" required>
                  <button type="submit"><%= game.status === 'finished' ? 'Update' : 'Set' %></button>
                </form>
              </td>
              <td>
                <form method="POST" action="/leagues/<%= league.id %>/games/<%= game.id %>/delete" data-confirm="Delete this game and all associated predictions?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-delete">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
  <%- include('partials/footer') %>
  <%- include('partials/consent-banner') %>
  <script src="/confirm.js"></script>
  <script src="/inputs.js"></script>
</body>
</html>
