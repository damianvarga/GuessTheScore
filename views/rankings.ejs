<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guess the Score - Rankings</title>
  <meta property="og:title" content="<%= league.name %> rankings on Guess the Score">
  <meta property="og:description" content="See who's leading the <%= league.name %> prediction pool. Guess the score, climb the board, beat your friends.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= pageUrl %>">
  <meta property="og:image" content="<%= siteUrl %>/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <% if (adsense) { %><meta name="google-adsense-account" content="<%= adsense.client %>"><% } %>
</head>
<body>
  <nav class="navbar">
    <div class="nav-inner">
      <a href="/leagues" class="nav-brand">Guess the Score</a>
      <div class="nav-links">
        <a href="/leagues">My Leagues</a>
        <a href="/leagues/<%= league.id %>/games">Games</a>
        <a href="/leagues/<%= league.id %>/rankings" class="active">Rankings</a>
        <% if (league.owner_id === user.id) { %>
          <a href="/leagues/<%= league.id %>/admin">Manage</a>
        <% } %>
        <span class="username"><%= user.username %></span>
        <form method="POST" action="/logout" class="logout-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit">Logout</button>
        </form>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="rankings-header">
      <h2>Rankings - <%= league.name %></h2>
      <button type="button" class="btn share-btn" data-share
        data-share-title="Guess the Score"
        data-share-text="I'm on the <%= league.name %> rankings board in Guess the Score. Can you beat me?"
        data-share-url="<%= pageUrl %>">Share</button>
    </div>
    <% if (rankings.length === 0) { %>
      <div class="empty">No players yet.</div>
    <% } else { %>
      <table class="rankings-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Player</th>
            <th>Total Points</th>
            <th>Scored / Total</th>
          </tr>
        </thead>
        <tbody>
          <% rankings.forEach((player, index) => { %>
            <tr class="rank-<%= index + 1 %>">
              <td class="rank-num"><%= index + 1 %></td>
              <td class="rank-player"><%= player.username %></td>
              <td class="rank-points"><%= player.total_points %></td>
              <td class="rank-stats"><%= player.predictions_scored %> / <%= player.total_predictions %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
    <%- include('partials/ad') %>
  </div>
  <%- include('partials/footer') %>
  <%- include('partials/consent-banner') %>
  <script src="/share.js"></script>
</body>
</html>
