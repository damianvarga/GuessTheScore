SESSION_SECRET=change-this-to-a-random-secret
PORT=3000
NODE_ENV=development

# HTTPS (optional)
# Direct TLS termination: set both paths and the app will serve HTTPS itself.
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# HTTP -> HTTPS redirect port (only used when HTTPS is enabled). Empty = disabled.
# HTTP_REDIRECT_PORT=80

# When redirecting HTTP to HTTPS, the public hostname and port to redirect to.
# Defaults to the request's Host header (port stripped) and the HTTPS PORT.
# Set these explicitly when the app sits behind a proxy or reverse proxy.
# PUBLIC_HTTPS_HOST=example.com
# PUBLIC_HTTPS_PORT=443

# Reverse proxy: set to the number of proxy hops (e.g. 1 behind nginx) so that
# req.secure and client IPs reflect the real client.
# TRUST_PROXY=1
